// Hover detail panel
function HoverPanel({
  phase,
  isVisible
}: {
  phase: typeof phases[0] | null
  isVisible: boolean
}) {
  if (!phase) return null

  return (
    <AnimatePresence>
      {isVisible && (
        <motion.div
          initial={{ opacity: 0, y: 20, scale: 0.95 }}
          animate={{ opacity: 1, y: 0, scale: 1 }}
          exit={{ opacity: 0, y: 10, scale: 0.98 }}
          transition={{ duration: 0.25, ease: 'easeOut' }}
          className="
            absolute bottom-4 left-1/2 -translate-x-1/2
            w-full max-w-xl
            bg-white/95 dark:bg-gray-900/95
            backdrop-blur-xl
            rounded-2xl
            border border-gray-200 dark:border-gray-700
            shadow-2xl
            overflow-hidden
            z-20
          "
        >
          <div className="grid grid-cols-[120px_1fr] gap-0">
            {/* Left side - Visual */}
            <div
              className="relative p-5 flex items-center justify-center"
              style={{ backgroundColor: `${phase.colors.primary}15` }}
            >
              <div
                className="w-16 h-16 rounded-2xl flex items-center justify-center"
                style={{ backgroundColor: phase.colors.primary }}
              >
                <div className="text-white scale-125">
                  {phase.icon}
